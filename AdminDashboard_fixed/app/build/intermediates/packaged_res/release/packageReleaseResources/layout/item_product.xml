<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- Product image placeholder -->
    <ImageView
        android:id="@+id/tvEmoji"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/bg_metric_card"
        android:src="@drawable/ic_product_placeholder"
        android:scaleType="center"
        android:contentDescription="Product image"
        android:layout_marginBottom="12dp"/>

    <!-- Product name -->
    <TextView
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="2dp"/>

    <!-- Category -->
    <TextView
        android:id="@+id/tvCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/text_tertiary"
        android:layout_marginBottom="6dp"/>

    <!-- Rating and sales row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/tvStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/star_yellow"/>

        <TextView
            android:id="@+id/tvRatingSales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/border_tertiary"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"/>

    <!-- Price + Stock row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_primary"/>

        <TextView
            android:id="@+id/tvStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:text="@string/edit"
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_btn_secondary"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/delete"
            android:textSize="12sp"
            android:textColor="@color/danger_text"
            android:background="@drawable/bg_btn_danger"/>

    </LinearLayout>

</LinearLayout>
